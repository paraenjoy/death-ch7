{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/deck.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"death-ch7.pdf\"; filename*=UTF-8''7%EC%9E%A5%20%EC%A3%BD%EC%9D%8C%EC%9D%98%20%EB%B3%B8%EC%A7%88%EC%97%90%20%EA%B4%80%ED%95%98%EC%97%AC%20-%20%EA%BA%BC%EC%A7%84%20%EA%B2%83%EA%B3%BC%20%EB%B6%80%EC%84%9C%EC%A7%84%20%EA%B2%83.pdf"
        }
      ]
    }
  ]
}